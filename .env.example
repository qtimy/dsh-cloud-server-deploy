# =============================================================================
# DSH 部署环境配置模板 —— 复制为 .env 后按需填写，切勿提交 .env 到 git。
#   cp .env.example .env
# =============================================================================

# ---- 浏览器加密访问 ----
# 公网访问 IP 或域名（写入 dsh-web 的 --trusted-host，用于 /api 浏览器信任栅栏）
TRUSTED_HOST=your-server-ip-or-domain

# nginx Basic Auth 用户名（浏览器打开时的登录账号）
BASIC_AUTH_USER=dsh

# nginx Basic Auth 密码（明文，install.sh 会用 openssl 生成 htpasswd 哈希）
BASIC_AUTH_PASSWORD=change-me-strong-password

# ---- 部署参数（可选，有默认值）----
# DSH npm 包版本（⚠️ 建议锁定具体版本，不要用 latest：caret 范围会连带升级子包，可能造成插件不兼容）
DSH_VERSION=<dsh-version>
# web-ui 全家桶版本（@linxin666/dsh-web-ui-all）
WEB_UI_ALL_VERSION=<web-ui-version>
# 监听端口（nginx 反向代理目标）
DSH_PORT=3080
# 安装用户（systemd 服务运行用户）
DSH_USER=ubuntu

# ---- 模型 / API Key 配置 ----
# 说明：本仓库不预设任何模型 provider 或密钥。
# 部署完成后，进入 DSH 的 Web UI 设置页配置你自己的模型与 API Key。
# 如需通过环境变量注入模型配置，请参考 templates/settings.yaml.tpl 的结构自行添加。

# Copy this file to .env, edit it, and never commit .env.

# Public IP address or DNS hostname accepted by dsh-web.
TRUSTED_HOST=your-server-ip-or-domain

# Browser-facing Nginx Basic Auth credentials.
BASIC_AUTH_USER=dsh
BASIC_AUTH_PASSWORD=change-me-strong-password

# Exact package versions only; latest and version ranges are rejected.
DSH_VERSION=0.1.0-rc.8

# Optional aggregate plugin. Leave empty for an official-core-only profile.
# Version 0.1.12 is the release tested on DSH RC.8.
WEB_UI_ALL_VERSION=0.1.12

# Bundled Shift-Router 0.6.1. Set false to omit it from the profile.
SHIFT_ROUTER_ENABLED=true

# Permit Models and plugin settings through the authenticated HTTPS edge.
# Nginx injects an authenticated-edge adapter; direct port 3080 stays restricted.
PUBLIC_SETTINGS_OVER_BASIC_AUTH=true

DSH_PORT=3080
DSH_USER=ubuntu
DEPLOY_DIR=/opt/dsh-deploy

# Usually blank. setup-letsencrypt.sh persists trusted paths in DEPLOY_DIR/tls.env.
SSL_CERT_PATH=
SSL_KEY_PATH=

# Add optional *_API_KEY entries here. The installer writes them to
# ~/.dsh/.credentials.yaml with YAML-safe quoted values.
